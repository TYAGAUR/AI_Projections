8. Build model selection and routing
Create services/model_router.py:
</>Python
import os

from dotenv import load_dotenv

load_dotenv()


MODEL_REGISTRY = {
    "fast": {
        "provider": "OpenAI",
        "model": os.getenv("OPENAI_FAST_MODEL", "gpt-5.5"),
        "supports_temperature": True
    },

    "quality": {
        "provider": "OpenAI",
        "model": os.getenv("OPENAI_QUALITY_MODEL", "gpt-5.5"),
        "supports_temperature": False
    }
}


def resolve_model(model_alias: str | None = None):

    selected_alias = model_alias or "fast"

    model_config = MODEL_REGISTRY.get(selected_alias)

    if model_config is None:
        raise ValueError("Unsupported model selection")

    return {
        "alias": selected_alias,
        **model_config
    }

Add these optional entries to .env:
</>env
OPENAI_FAST_MODEL=gpt-5.5
OPENAI_QUALITY_MODEL=gpt-5.5



For this exercise, both aliases can point to the same model. Later, you can configure different models based on your account's access and the capabilities you need.
Why model routing matters
Suppose your application receives two requests:
•	A simple classification task.
•	A complex technical architecture question.
Your model router can choose different models based on task complexity, latency requirements and budget.
This is the foundation of intelligent model routing in an AI platform.
9. Update the LLM service
Open services/llm_service.py and replace the previous generate_ai_response() implementation with:
</>Python
from uuid import uuid4

from openai import OpenAIError

from config.llm_config import client

from services.model_router import resolve_model

from services.prompt_service import get_prompt_instructions


def generate_ai_response(
    prompt: str,
    max_output_tokens: int = 500,
    template_name: str = "general_assistant",
    model_alias: str = "fast",
    temperature: float | None = None
):

    try:

        # Step 1: Load prompt template
        prompt_config = get_prompt_instructions(
            template_name
        )

        # Step 2: Select model
        model_config = resolve_model(model_alias)

        # Step 3: Prepare API parameters
        api_params = {
            "model": model_config["model"],
            "instructions": prompt_config["instructions"],
            "input": prompt,
            "max_output_tokens": max_output_tokens
        }

        # Step 4: Apply temperature only when supported
        if temperature is not None:

            if not model_config["supports_temperature"]:
                raise ValueError(
                    "Temperature is not supported "
                    "for this model configuration."
                )

            api_params["temperature"] = temperature

        # Step 5: Execute OpenAI request
        response = client.responses.create(**api_params)

        generated_text = response.output_text

        if not generated_text:
            raise RuntimeError(
                "The model returned no text output."
            )

        usage = response.usage

        return {
            "request_id": str(uuid4()),
            "model": model_config["model"],
            "model_alias": model_config["alias"],
            "template_name": prompt_config["template_name"],
            "prompt_version": prompt_config["version"],
            "status": "success",
            "prompt": prompt,
            "response": generated_text,
            "input_tokens": usage.input_tokens if usage else 0,
            "output_tokens": usage.output_tokens if usage else 0,
            "total_tokens": usage.total_tokens if usage else 0
        }

    except OpenAIError as error:

        print(f"OpenAI error: {type(error).__name__}")

        raise RuntimeError(
            "AI provider request failed."
        ) from error

Notice that the application now controls three things independently:
•	Which prompt instructions are used.
•	Which model configuration is selected.
•	Which generation parameters are applied.
10. Add advanced request schemas
Create schemas/prompt_schema.py:
</>Python
from pydantic import BaseModel, Field


class AdvancedLLMRequest(BaseModel):

    prompt: str = Field(
        ...,
        min_length=5,
        max_length=10000
    )

    template_name: str = Field(
        default="general_assistant"
    )

    model_alias: str = Field(
        default="fast"
    )

    max_output_tokens: int = Field(
        default=500,
        ge=1,
        le=4000
    )

    temperature: float | None = Field(
        default=None,
        ge=0,
        le=2
    )


This is the data contract between your client and your advanced LLM endpoint.
11. Add the advanced LLM endpoint
Open api/endpoints.py.
Add this import:
</>Python
from schemas.prompt_schema import AdvancedLLMRequest

Then add this endpoint. Keep your existing POST /requests endpoint unchanged.
</>Python
@router.post("/requests/advanced")
def create_advanced_request(
    request: AdvancedLLMRequest,
    db: Session = Depends(get_db),
    current_user: User = Depends(get_current_user)
):

    try:

        result = generate_ai_response(
            prompt=request.prompt,
            max_output_tokens=request.max_output_tokens,
            template_name=request.template_name,
            model_alias=request.model_alias,
            temperature=request.temperature
        )

        save_llm_request(
            db=db,
            request_data=result,
            user_id=current_user.id
        )

        return {
            "request_id": result["request_id"],
            "model": result["model"],
            "model_alias": result["model_alias"],
            "template_name": result["template_name"],
            "prompt_version": result["prompt_version"],
            "status": result["status"],
            "response": result["response"],
            "input_tokens": result["input_tokens"],
            "output_tokens": result["output_tokens"],
            "total_tokens": result["total_tokens"]
        }

    except ValueError as error:

        raise HTTPException(
            status_code=400,
            detail=str(error)
        )

    except RuntimeError:

        raise HTTPException(
            status_code=502,
            detail="AI provider request failed."
        )

