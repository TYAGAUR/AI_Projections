File 2: services/vector_store.py
</>Python

from uuid import uuid4

from config.vector_config import knowledge_collection
from services.embedding_service import (
    generate_embedding
)


def add_knowledge(
    title: str,
    content: str,
    user_id: int
) -> dict:

    embedding = generate_embedding(content)

    document_id = str(uuid4())

    knowledge_collection.add(
        ids=[document_id],
        embeddings=[embedding],
        documents=[content],
        metadatas=[{
            "title": title,
            "user_id": str(user_id)
        }]
    )

    return {
        "document_id": document_id,
        "title": title,
        "status": "indexed"
    }


def search_knowledge(
    question: str,
    user_id: int,
    top_k: int = 3
) -> list[dict]:

    query_embedding = generate_embedding(question)

    results = knowledge_collection.query(
        query_embeddings=[query_embedding],
        n_results=top_k,
        where={"user_id": str(user_id)},
        include=[
            "documents",
            "metadatas",
            "distances"
        ]
    )

    documents = results["documents"][0]
    metadatas = results["metadatas"][0]
    distances = results["distances"][0]
    ids = results["ids"][0]

    matches = []

    for document_id, document, metadata, distance in zip(
        ids, documents, metadatas, distances
    ):
        matches.append({
            "document_id": document_id,
            "title": metadata["title"],
            "content": document,
            "distance": round(distance, 4),
            "similarity_score": round(1 - distance, 4)
        })

    return matches

Understand the two operations:
•	add_knowledge() generates an embedding and stores the vector, original text and metadata.
•	search_knowledge() generates an embedding for the question and retrieves the closest stored vectors.
The user_id filter ensures that a search only returns records belonging to that user. This is a basic isolation measure; production systems also need robust authorization, tenant isolation and access-control testing.
7. Create request and response schemas
Create schemas/knowledge_schema.py:
</>Python

from pydantic import BaseModel, Field


class KnowledgeCreateRequest(BaseModel):
    title: str = Field(
        ...,
        min_length=2,
        max_length=200
    )

    content: str = Field(
        ...,
        min_length=10,
        max_length=20000
    )


class KnowledgeSearchRequest(BaseModel):
    question: str = Field(
        ...,
        min_length=3,
        max_length=5000
    )

    top_k: int = Field(
        default=3,
        ge=1,
        le=10
    )


class KnowledgeCreateResponse(BaseModel):
    document_id: str
    title: str
    status: str


class KnowledgeSearchResult(BaseModel):
    document_id: str
    title: str
    content: str
    distance: float
    similarity_score: float


class KnowledgeSearchResponse(BaseModel):
    question: str
    total_results: int
    results: list[KnowledgeSearchResult]

8. Build the Knowledge API endpoints
Create api/knowledge.py:
</>Python

from fastapi import APIRouter, Depends, HTTPException

from api.auth import get_current_user

from schemas.knowledge_schema import (
    KnowledgeCreateRequest,
    KnowledgeCreateResponse,
    KnowledgeSearchRequest,
    KnowledgeSearchResponse
)

from services.vector_store import (
    add_knowledge,
    search_knowledge
)

router = APIRouter(
    prefix="/knowledge",
    tags=["Knowledge Base"]
)


@router.post(
    "/documents",
    response_model=KnowledgeCreateResponse
)
def create_knowledge_document(
    request: KnowledgeCreateRequest,
    current_user=Depends(get_current_user)
):
    try:
        result = add_knowledge(
            title=request.title,
            content=request.content,
            user_id=current_user.id
        )

        return result

    except ValueError as error:
        raise HTTPException(
            status_code=400,
            detail=str(error)
        )

    except Exception:
        raise HTTPException(
            status_code=502,
            detail="Knowledge indexing failed."
        )


@router.post(
    "/search",
    response_model=KnowledgeSearchResponse
)
def search_knowledge_documents(
    request: KnowledgeSearchRequest,
    current_user=Depends(get_current_user)
):
    try:
        results = search_knowledge(
            question=request.question,
            user_id=current_user.id,
            top_k=request.top_k
        )

        return {
            "question": request.question,
            "total_results": len(results),
            "results": results
        }

    except Exception:
        raise HTTPException(
            status_code=502,
            detail="Knowledge search failed."
        )

These endpoints use your existing JWT authentication dependency. The current_user.id value is taken from the authenticated user, not supplied by the API caller.
