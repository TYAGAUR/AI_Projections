from config.database import Base


class AIRequestRecord(Base):

    __tablename__ = "ai_requests"

    id = Column(
        Integer,
        primary_key=True,
        index=True
    )

    request_id = Column(
        String(100),
        unique=True,
        nullable=False,
        index=True
    )

    model = Column(
        String(100),
        nullable=False
    )

    provider = Column(
        String(100),
        nullable=True
    )

    prompt = Column(
        Text,
        nullable=False
    )

    status = Column(
        String(50),
        nullable=False
    )

    input_tokens = Column(
        Integer,
        default=0
    )

    output_tokens = Column(
        Integer,
        default=0
    )

    total_tokens = Column(
        Integer,
        default=0
    )

    created_at = Column(
        DateTime(timezone=True),
        default=lambda: datetime.now(timezone.utc),
        nullable=False
    )

Understand the table
Your AIRequestRecord Python class represents the PostgreSQL table ai_requests.
Database column	Python type	Purpose
id	Integer	Primary key
request_id	String	Unique API request identifier
model	String	AI model used
provider	String	Model provider
prompt	Text	User prompt
status	String	Request status
input_tokens	Integer	Input token estimate
output_tokens	Integer	Output token estimate
total_tokens	Integer	Total token estimate
created_at	DateTime	Request creation timestamp
Notice that we did not write a CREATE TABLE SQL command. SQLAlchemy will create the table from this Python class.
10. Create the database service
Now we'll create functions to save and retrieve records.
File: services/request_service.py
</>Python
from sqlalchemy.orm import Session

from models.request_model import AIRequestRecord


def save_ai_request(db: Session, request_data):

    new_record = AIRequestRecord(
        request_id=request_data.request_id,
        model=request_data.model,
        provider=request_data.provider,
        prompt=request_data.prompt,
        status=request_data.status,
        input_tokens=request_data.input_tokens,
        output_tokens=request_data.output_tokens,
        total_tokens=request_data.total_tokens
    )

    db.add(new_record)

    db.commit()

    db.refresh(new_record)

    return new_record


def get_all_requests(db: Session, limit: int = 50):

    return (
        db.query(AIRequestRecord)
        .order_by(AIRequestRecord.id.desc())
        .limit(limit)
        .all()
    )


def get_request_by_id(db: Session, request_id: str):

    return (
        db.query(AIRequestRecord)
        .filter(
            AIRequestRecord.request_id == request_id
        )
        .first()
    )

Understand the database operations
SQLAlchemy command	Purpose
db.add()	Adds a new record to the session
db.commit()	Saves the transaction
db.refresh()	Reloads the saved database record
db.query()	Starts a database query
.filter()	Filters records
.all()	Returns all matching records
.first()	Returns the first matching record
One important concept: commit() makes the database transaction permanent. If a transaction fails, you should roll it back before reusing the session. We'll handle that in the API endpoint.
