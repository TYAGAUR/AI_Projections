12. Connect the database to your API
Open:
api/endpoints.py
Replace the file with this complete updated version:
</>Python
from fastapi import (
    APIRouter,
    HTTPException,
    Depends,
    Query
)

from sqlalchemy.orm import Session
from sqlalchemy.exc import SQLAlchemyError

from config.database import get_db

from services.model_service import (
    get_all_models,
    get_model_by_id,
    process_ai_request
)

from services.request_service import (
    save_ai_request,
    get_all_requests,
    get_request_by_id
)

from schemas.request_schema import (
    AIRequest,
    AIResponse,
    PromptValidationRequest,
    PromptValidationResponse,
    AIRequestHistoryResponse
)


router = APIRouter()


@router.get("/models")
def list_models():

    models = get_all_models()

    return {
        "count": len(models),
        "models": models
    }


@router.get("/models/{model_id}")
def retrieve_model(model_id: str):

    model = get_model_by_id(model_id)

    if model is None:
        raise HTTPException(
            status_code=404,
            detail="AI model not found"
        )

    return model


@router.post(
    "/requests",
    response_model=AIResponse
)
def create_ai_request(
    request: AIRequest,
    db: Session = Depends(get_db)
):

    response = process_ai_request(request)

    if response is None:
        raise HTTPException(
            status_code=404,
            detail="Requested AI model does not exist"
        )

    if isinstance(response, str):
        if response == "provider_mismatch":
            raise HTTPException(
                status_code=400,
                detail="Selected provider does not match the model"
            )

    try:

        save_ai_request(
            db=db,
            request_data=response
        )

        return response

    except SQLAlchemyError:

        db.rollback()

        raise HTTPException(
            status_code=500,
            detail="Unable to save AI request to database"
        )


@router.post(
    "/requests/validate",
    response_model=PromptValidationResponse
)
def validate_prompt(request: PromptValidationRequest):

    cleaned_prompt = request.prompt.strip()

    return PromptValidationResponse(
        valid=True,
        prompt_length=len(cleaned_prompt),
        message="Prompt validation successful"
    )


@router.get(
    "/requests/history",
    response_model=list[AIRequestHistoryResponse]
)
def request_history(
    limit: int = Query(default=50, ge=1, le=200),
    db: Session = Depends(get_db)
):

    return get_all_requests(
        db=db,
        limit=limit
    )


@router.get(
    "/requests/{request_id}",
    response_model=AIRequestHistoryResponse
)
def retrieve_request(
    request_id: str,
    db: Session = Depends(get_db)
):

    record = get_request_by_id(
        db=db,
        request_id=request_id
    )

    if record is None:
        raise HTTPException(
            status_code=404,
            detail="Request record not found"
        )

    return record

Important: Keep /requests/history above /requests/{request_id}. Otherwise, the dynamic route could interpret history as a request ID.
We now have two new database endpoints:
Endpoint	Method	Purpose
/requests/history	GET	Retrieve saved requests
/requests/{request_id}	GET	Retrieve one saved request
13. Update main.py to create the table
Replace your main.py with:
</>Python
from contextlib import asynccontextmanager

from fastapi import FastAPI

from api.endpoints import router

from config.database import Base, engine

# Import the ORM model so SQLAlchemy knows about the table
from models.request_model import AIRequestRecord


@asynccontextmanager
async def lifespan(app: FastAPI):

    # Create database tables if they do not exist
    Base.metadata.create_all(bind=engine)

    yield


app = FastAPI(
    title="AI Platform Gateway",
    description="AI model management and request processing platform",
    version="1.2.0",
    lifespan=lifespan
)


@app.get("/")
def home():

    return {
        "message": "Welcome to AI Platform Gateway",
        "status": "running"
    }


@app.get("/health")
def health_check():

    return {
        "status": "healthy",
        "service": "AI Platform Gateway",
        "database": "configured"
    }


app.include_router(router)

The lifespan function runs when your FastAPI application starts.
Base.metadata.create_all() checks the registered SQLAlchemy models and creates missing tables.
It does not automatically update existing table structures when you change your models. For future schema changes, we'll learn database migrations with Alembic.
