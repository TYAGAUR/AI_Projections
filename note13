9. Implement CRUD operations in the request service
Open:
services/request_service.py
Replace the file with:
</>Python 
from sqlalchemy.orm import Session

from models.request_model import AIRequestRecord
from models.user_model import User


# CREATE: Save an AI request
def save_ai_request(db: Session, request_data, user_id=None):

    new_record = AIRequestRecord(
        request_id=request_data.request_id,
        user_id=user_id,
        model=request_data.model,
        provider=request_data.provider,
        prompt=request_data.prompt,
        status=request_data.status,
        input_tokens=request_data.input_tokens,
        output_tokens=request_data.output_tokens,
        total_tokens=request_data.total_tokens
    )

    db.add(new_record)
    db.commit()
    db.refresh(new_record)

    return new_record


# READ: Retrieve all requests
def get_all_requests(db: Session, limit: int = 50, offset: int = 0):

    return (
        db.query(AIRequestRecord)
        .order_by(AIRequestRecord.id.desc())
        .offset(offset)
        .limit(limit)
        .all()
    )


# READ: Retrieve one request
def get_request_by_id(db: Session, request_id: str):

    return (
        db.query(AIRequestRecord)
        .filter(
            AIRequestRecord.request_id == request_id
        )
        .first()
    )


# READ: Filter requests by model
def get_requests_by_model(db: Session, model_name: str):

    return (
        db.query(AIRequestRecord)
        .filter(
            AIRequestRecord.model == model_name
        )
        .order_by(AIRequestRecord.id.desc())
        .all()
    )


# READ: Filter requests by status
def get_requests_by_status(db: Session, status: str):

    return (
        db.query(AIRequestRecord)
        .filter(
            AIRequestRecord.status == status
        )
        .order_by(AIRequestRecord.id.desc())
        .all()
    )


# UPDATE: Update request status
def update_request_status(
    db: Session,
    request_id: str,
    new_status: str
):

    record = get_request_by_id(db, request_id)

    if record is None:
        return None

    record.status = new_status

    db.commit()
    db.refresh(record)

    return record


# DELETE: Delete a request
def delete_request(db: Session, request_id: str):

    record = get_request_by_id(db, request_id)

    if record is None:
        return None

    db.delete(record)
    db.commit()

    return record


# CREATE: Register a user
def create_user(db: Session, user_data):

    new_user = User(
        name=user_data.name,
        email=user_data.email
    )

    db.add(new_user)
    db.commit()
    db.refresh(new_user)

    return new_user


# READ: Retrieve a user
def get_user_by_id(db: Session, user_id: int):

    return (
        db.query(User)
        .filter(User.id == user_id)
        .first()
    )

Understand the CRUD workflow
CREATE
db.add() + db.commit()
Insert a new database record.
READ
db.query()
Retrieve records, filter and paginate results.
UPDATE
Modify object + db.commit()
Change an existing database record.
DELETE
db.delete() + db.commit()
Remove a database record.
10. Build usage analytics with SQLAlchemy
Create a new file:
services/analytics_service.py
Add:
</>Python 
from sqlalchemy.orm import Session
from sqlalchemy import func

from models.request_model import AIRequestRecord


def get_usage_analytics(db: Session):

    result = db.query(
        func.count(AIRequestRecord.id).label(
            "total_requests"
        ),

        func.coalesce(
            func.sum(AIRequestRecord.input_tokens), 0
        ).label("total_input_tokens"),

        func.coalesce(
            func.sum(AIRequestRecord.output_tokens), 0
        ).label("total_output_tokens"),

        func.coalesce(
            func.sum(AIRequestRecord.total_tokens), 0
        ).label("total_tokens")

    ).first()

    return {
        "total_requests": result.total_requests,
        "total_input_tokens": result.total_input_tokens,
        "total_output_tokens": result.total_output_tokens,
        "total_tokens": result.total_tokens
    }


def get_model_usage(db: Session):

    return (
        db.query(
            AIRequestRecord.model,
            func.count(AIRequestRecord.id).label(
                "total_requests"
            ),
            func.sum(
                AIRequestRecord.total_tokens
            ).label("total_tokens")
        )
        .group_by(AIRequestRecord.model)
        .all()
    )

Understand aggregate functions
Function	Purpose
func.count()	Counts records
func.sum()	Calculates total
func.coalesce()	Replaces NULL with a specified value
group_by()	Groups records by a column
For example, this SQL:
</>SQL
SELECT
    model,
    COUNT(*) AS total_requests,
    SUM(total_tokens) AS total_tokens
FROM ai_requests
GROUP BY model;

can be implemented using SQLAlchemy as shown above.
This is particularly useful for an AI platform because you need to monitor token consumption and model usage.
