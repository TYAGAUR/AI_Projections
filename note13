)

from services.request_service import (
    save_ai_request,
    get_all_requests,
    get_request_by_id,
    get_requests_by_model,
    get_requests_by_status,
    update_request_status,
    delete_request,
    create_user,
    get_user_by_id
)

from services.analytics_service import (
    get_usage_analytics,
    get_model_usage
)

from schemas.request_schema import (
    AIRequest,
    AIResponse,
    PromptValidationRequest,
    PromptValidationResponse,
    AIRequestHistoryResponse,
    UserCreate,
    UserResponse,
    AIRequestUpdate,
    UsageAnalyticsResponse
)


router = APIRouter()


# --------------------------------
# MODEL ENDPOINTS
# --------------------------------

@router.get("/models")
def list_models():

    models = get_all_models()

    return {
        "count": len(models),
        "models": models
    }


@router.get("/models/{model_id}")
def retrieve_model(model_id: str):

    model = get_model_by_id(model_id)

    if model is None:
        raise HTTPException(
            status_code=404,
            detail="AI model not found"
        )

    return model


# --------------------------------
# CREATE AI REQUEST
# --------------------------------

@router.post(
    "/requests",
    response_model=AIResponse
)
def create_ai_request(
    request: AIRequest,
    db: Session = Depends(get_db)
):

    response = process_ai_request(request)

    if response is None:
        raise HTTPException(
            status_code=404,
            detail="Requested AI model does not exist"
        )

    if isinstance(response, str):
        if response == "provider_mismatch":
            raise HTTPException(
                status_code=400,
                detail="Selected provider does not match the model"
            )

    try:

        save_ai_request(
            db=db,
            request_data=response
        )

        return response

    except SQLAlchemyError:

        db.rollback()

        raise HTTPException(
            status_code=500,
            detail="Unable to save AI request"
        )


# --------------------------------
# PROMPT VALIDATION
# --------------------------------

@router.post(
    "/requests/validate",
    response_model=PromptValidationResponse
)
def validate_prompt(request: PromptValidationRequest):

    cleaned_prompt = request.prompt.strip()

    return PromptValidationResponse(
        valid=True,
        prompt_length=len(cleaned_prompt),
        message="Prompt validation successful"
    )


# --------------------------------
# PAGINATED REQUEST HISTORY
# --------------------------------

@router.get(
    "/requests/history",
    response_model=list[AIRequestHistoryResponse]
)
def request_history(
    limit: int = Query(default=10, ge=1, le=100),
    offset: int = Query(default=0, ge=0),
    db: Session = Depends(get_db)
):

    return get_all_requests(
        db=db,
        limit=limit,
        offset=offset
    )


# --------------------------------
# FILTER BY MODEL
# --------------------------------

@router.get(
    "/requests/model/{model_name}",
    response_model=list[AIRequestHistoryResponse]
)
def filter_by_model(
    model_name: str,
    db: Session = Depends(get_db)
):

    return get_requests_by_model(
        db=db,
        model_name=model_name
    )


# --------------------------------
# FILTER BY STATUS
# --------------------------------

@router.get(
    "/requests/status/{status}",
    response_model=list[AIRequestHistoryResponse]
)
def filter_by_status(
    status: str,
    db: Session = Depends(get_db)
):

    allowed_statuses = [
        "pending",
        "processing",
        "success",
        "failed",
        "cancelled"
    ]

    if status not in allowed_statuses:
        raise HTTPException(
            status_code=400,
            detail="Invalid request status"
        )

    return get_requests_by_status(
        db=db,
        status=status
    )


# --------------------------------
# UPDATE REQUEST STATUS
# --------------------------------

@router.put(
    "/requests/{request_id}",
    response_model=AIRequestHistoryResponse
)
def update_request(
    request_id: str,
    request_data: AIRequestUpdate,
    db: Session = Depends(get_db)
):

    record = update_request_status(
        db=db,
        request_id=request_id,
        new_status=request_data.status
    )

    if record is None:
        raise HTTPException(
            status_code=404,
            detail="Request record not found"
        )

    return record


# --------------------------------
# DELETE REQUEST
# --------------------------------

@router.delete("/requests/{request_id}")
def remove_request(
    request_id: str,
    db: Session = Depends(get_db)
):

    record = delete_request(
        db=db,
        request_id=request_id
    )

    if record is None:
        raise HTTPException(
            status_code=404,
            detail="Request record not found"
        )

    return {
        "message": "Request deleted successfully",
        "request_id": request_id
    }


