# --------------------------------
# USAGE ANALYTICS
# --------------------------------

@router.get(
    "/usage",
    response_model=UsageAnalyticsResponse
)
def usage_analytics(db: Session = Depends(get_db)):

    return get_usage_analytics(db)


# --------------------------------
# MODEL USAGE ANALYTICS
# --------------------------------

@router.get("/usage/models")
def model_usage_analytics(db: Session = Depends(get_db)):

    results = get_model_usage(db)

    return {
        "models": [
            {
                "model": row.model,
                "total_requests": row.total_requests,
                "total_tokens": row.total_tokens or 0
            }
            for row in results
        ]
    }

Important: The endpoint ordering is intentional. Static routes such as /requests/history and /requests/model/{model_name} are defined before /requests/{request_id} to prevent route matching conflicts.
Also, the POST /requests endpoint still saves requests without associating them with a user. We have introduced the user relationship today, but user authentication and assigning requests to authenticated users will be implemented in a later lesson.
