4. Integrate asynchronous OpenAI requests
Your Day 15 implementation uses the synchronous OpenAI client. We'll now add a separate asynchronous client.
The OpenAI Python SDK provides AsyncOpenAI, which supports await and asynchronous network calls.
Step 4.1 – Update config/llm_config.py
Keep your existing synchronous client because Day 15 and Day 16 still use it. Add the asynchronous client:
</>Python
import os

from dotenv import load_dotenv
from openai import OpenAI, AsyncOpenAI

load_dotenv()

OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")

OPENAI_MODEL = os.getenv(
    "OPENAI_MODEL",
    "gpt-5.5"
)

OPENAI_TIMEOUT = float(
    os.getenv("OPENAI_TIMEOUT", "30")
)

if not OPENAI_API_KEY:
    raise RuntimeError(
        "OPENAI_API_KEY is missing. Check your .env file."
    )

# Synchronous client – existing integration
client = OpenAI(
    api_key=OPENAI_API_KEY,
    timeout=OPENAI_TIMEOUT,
    max_retries=2
)

# Asynchronous client – new integration
async_client = AsyncOpenAI(
    api_key=OPENAI_API_KEY,
    timeout=OPENAI_TIMEOUT,
    max_retries=2
)

Step 4.2 – Create services/async_llm_service.py
</>Python
from uuid import uuid4

from openai import OpenAIError

from config.llm_config import (
    async_client,
    OPENAI_MODEL
)


async def generate_ai_response_async(
    prompt: str,
    max_output_tokens: int = 500
):

    try:

        response = await async_client.responses.create(
            model=OPENAI_MODEL,
            instructions=(
                "You are a professional enterprise AI assistant. "
                "Provide clear, accurate and useful answers."
            ),
            input=prompt,
            max_output_tokens=max_output_tokens
        )

        generated_text = response.output_text

        if not generated_text:
            raise RuntimeError(
                "The model returned no text output."
            )

        usage = response.usage

        return {
            "request_id": str(uuid4()),
            "model": OPENAI_MODEL,
            "status": "success",
            "prompt": prompt,
            "response": generated_text,
            "input_tokens": usage.input_tokens if usage else 0,
            "output_tokens": usage.output_tokens if usage else 0,
            "total_tokens": usage.total_tokens if usage else 0
        }

    except OpenAIError as error:

        print(
            f"OpenAI async error: {type(error).__name__}"
        )

        raise RuntimeError(
            "AI provider request failed."
        ) from error

