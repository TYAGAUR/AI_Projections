from models.request_model import AIRequestRecord


def save_llm_request(
    db,
    request_data: dict,
    user_id: int
):
    record = AIRequestRecord(
        request_id=request_data["request_id"],
        user_id=user_id,
        model=request_data["model"],
        provider="OpenAI",
        prompt=request_data["prompt"],
        status=request_data["status"],
        input_tokens=request_data["input_tokens"],
        output_tokens=request_data["output_tokens"],
        total_tokens=request_data["total_tokens"]
    )

    try:
        db.add(record)
        db.commit()
        db.refresh(record)

        return record

    except Exception:
        db.rollback()
        raise

Notice that we store the authenticated user's ID. This means the request history can be associated with the person who submitted it.
