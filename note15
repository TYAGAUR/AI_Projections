8. Build the real LLM service
Create services/llm_service.py:
</>Python
from uuid import uuid4

from openai import OpenAIError

from config.llm_config import client, OPENAI_MODEL


def generate_ai_response(
    prompt: str,
    max_output_tokens: int = 500
):
    """
    Sends a prompt to OpenAI and returns
    the generated response and token usage.
    """

    try:

        response = client.responses.create(
            model=OPENAI_MODEL,
            instructions=(
                "You are an AI assistant inside an "
                "enterprise AI platform. Provide accurate, "
                "clear and professional responses."
            ),
            input=prompt,
            max_output_tokens=max_output_tokens
        )

        generated_text = response.output_text

        if not generated_text:
            raise RuntimeError(
                "The model returned no text output."
            )

        usage = response.usage

        input_tokens = (
            usage.input_tokens if usage else 0
        )

        output_tokens = (
            usage.output_tokens if usage else 0
        )

        total_tokens = (
            usage.total_tokens if usage else 0
        )

        return {
            "request_id": str(uuid4()),
            "model": OPENAI_MODEL,
            "status": "success",
            "prompt": prompt,
            "response": generated_text,
            "input_tokens": input_tokens,
            "output_tokens": output_tokens,
            "total_tokens": total_tokens
        }

    except OpenAIError as error:

        # Log the technical error on the server,
        # but do not expose credentials or raw details.
        print(f"OpenAI API error: {type(error).__name__}")

        raise RuntimeError(
            "The AI provider could not process the request."
        ) from error

