5. Build the document extraction service
Create services/document_processor.py.
This service will:
1.	Identify the uploaded file type.
2.	Extract text from PDF, DOCX or TXT.
3.	Split the extracted text into overlapping chunks.
4.	Return the chunks with source information.
</>Python

from io import BytesIO
from pathlib import Path

from pypdf import PdfReader
from docx import Document


def extract_document_text(
    file_bytes: bytes,
    filename: str
) -> list[dict]:

    extension = Path(filename).suffix.lower()
    extracted_pages = []

    if extension == ".pdf":
        reader = PdfReader(BytesIO(file_bytes))

        if reader.is_encrypted:
            raise ValueError("Encrypted PDFs are not supported.")

        for page_number, page in enumerate(
            reader.pages, start=1
        ):
            text = page.extract_text() or ""

            if text.strip():
                extracted_pages.append({
                    "page_number": page_number,
                    "text": text.strip()
                })

    elif extension == ".docx":
        document = Document(BytesIO(file_bytes))

        paragraphs = [
            paragraph.text.strip()
            for paragraph in document.paragraphs
            if paragraph.text.strip()
        ]

        text = "\n".join(paragraphs)

        if text:
            extracted_pages.append({
                "page_number": None,
                "text": text
            })

    elif extension == ".txt":
        text = file_bytes.decode("utf-8-sig").strip()

        if text:
            extracted_pages.append({
                "page_number": None,
                "text": text
            })

    else:
        raise ValueError(
            "Only PDF, DOCX and TXT files are supported."
        )

    if not extracted_pages:
        raise ValueError(
            "No readable text found in the document. "
            "Scanned PDFs require OCR."
        )

    return extracted_pages


def chunk_text(
    text: str,
    chunk_size: int = 500,
    overlap: int = 75
) -> list[str]:

    if chunk_size <= 0:
        raise ValueError("chunk_size must be positive.")

    if overlap < 0 or overlap >= chunk_size:
        raise ValueError(
            "overlap must be non-negative and smaller "
            "than chunk_size."
        )

    words = text.split()

    if not words:
        return []

    chunks = []
    start = 0

    while start < len(words):
        end = min(start + chunk_size, len(words))

        chunk = " ".join(words[start:end])
        chunks.append(chunk)

        if end == len(words):
            break

        start = end - overlap

    return chunks
Important: This is a simple word-based chunker for learning. Production systems often use token-based or structure-aware chunking to preserve headings, tables, paragraphs and other document boundaries.
