Create schemas/document_schema.py:
</>Python

from pydantic import BaseModel, Field


class DocumentUploadResponse(BaseModel):
    document_id: str
    filename: str
    total_chunks: int
    status: str


class DocumentSearchRequest(BaseModel):
    question: str = Field(
        ...,
        min_length=3,
        max_length=5000
    )

    top_k: int = Field(
        default=3,
        ge=1,
        le=10
    )


class RetrievedChunk(BaseModel):
    chunk_id: str
    document_id: str
    filename: str
    chunk_index: int
    page_number: int | None
    content: str
    distance: float
    similarity_score: float


class DocumentSearchResponse(BaseModel):
    question: str
    total_results: int
    results: list[RetrievedChunk]
9. Build the document upload and search endpoints
Create api/documents.py:
</>Python

from pathlib import Path
from uuid import uuid4

from fastapi import (
    APIRouter,
    Depends,
    File,
    HTTPException,
    UploadFile
)

from api.auth import get_current_user

from schemas.document_schema import (
    DocumentUploadResponse,
    DocumentSearchRequest,
    DocumentSearchResponse
)

from services.document_processor import (
    extract_document_text,
    chunk_text
)

from services.vector_store import (
    index_document_chunks,
    search_document_chunks
)


router = APIRouter(
    prefix="/documents",
    tags=["Document Intelligence"]
)

MAX_FILE_SIZE = 10 * 1024 * 1024

ALLOWED_EXTENSIONS = {
    ".pdf",
    ".docx",
    ".txt"
}


@router.post(
    "/upload",
    response_model=DocumentUploadResponse
)
def upload_document(
    file: UploadFile = File(...),
    current_user=Depends(get_current_user)
):

    filename = Path(file.filename or "").name
    extension = Path(filename).suffix.lower()

    if extension not in ALLOWED_EXTENSIONS:
        raise HTTPException(
            status_code=400,
            detail="Only PDF, DOCX and TXT files are supported."
        )

    file_bytes = file.file.read(MAX_FILE_SIZE + 1)

    if not file_bytes:
        raise HTTPException(
            status_code=400,
            detail="Uploaded file is empty."
        )

    if len(file_bytes) > MAX_FILE_SIZE:
        raise HTTPException(
            status_code=413,
            detail="File size cannot exceed 10 MB."
        )

    try:
        extracted_pages = extract_document_text(
            file_bytes,
            filename
        )

        all_chunks = []

        chunk_index = 0

        for page in extracted_pages:
            page_chunks = chunk_text(
                page["text"],
                chunk_size=500,
                overlap=75
            )

            for chunk in page_chunks:
                all_chunks.append({
                    "chunk_index": chunk_index,
                    "page_number": page["page_number"],
                    "text": chunk
                })

                chunk_index += 1

        if not all_chunks:
            raise ValueError(
                "No usable text chunks were created."
            )

        document_id = str(uuid4())

        indexed_count = index_document_chunks(
            chunks=all_chunks,
            document_id=document_id,
            filename=filename,
            user_id=current_user.id
        )

        return {
            "document_id": document_id,
            "filename": filename,
            "total_chunks": indexed_count,
            "status": "indexed"
        }

    except ValueError as error:
        raise HTTPException(
            status_code=400,
            detail=str(error)
        )

    except Exception:
        raise HTTPException(
            status_code=502,
            detail="Document processing or indexing failed."
        )


@router.post(
    "/search",
    response_model=DocumentSearchResponse
)
def search_documents(
    request: DocumentSearchRequest,
    current_user=Depends(get_current_user)
):

    try:
        results = search_document_chunks(
            question=request.question,
            user_id=current_user.id,
            top_k=request.top_k
        )

        return {
            "question": request.question,
            "total_results": len(results),
            "results": results
        }

    except Exception:
        raise HTTPException(
            status_code=502,
            detail="Document search failed."
        )

The endpoint has a 10 MB upload limit and accepts PDF, DOCX and TXT files. It does not yet support scanned PDFs, OCR, or tables and images embedded in documents.
