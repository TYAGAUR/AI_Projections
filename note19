7. Store document chunks in ChromaDB
Open services/vector_store.py.
Keep your existing Day 18 functions, and add the following functions below them.
</>Python

from uuid import uuid4

from config.vector_config import knowledge_collection
from services.embedding_service import (
    generate_embedding,
    generate_embeddings
)


def index_document_chunks(
    chunks: list[dict],
    document_id: str,
    filename: str,
    user_id: int
) -> int:

    batch_size = 100
    indexed_count = 0

    for start in range(0, len(chunks), batch_size):
        batch = chunks[start:start + batch_size]

        texts = [item["text"] for item in batch]
        embeddings = generate_embeddings(texts)

        ids = [str(uuid4()) for _ in batch]

        metadatas = []

        for item in batch:
            metadatas.append({
                "document_id": document_id,
                "filename": filename,
                "user_id": str(user_id),
                "chunk_index": item["chunk_index"],
                "page_number": (
                    item["page_number"]
                    if item["page_number"] is not None
                    else -1
                )
            })

        knowledge_collection.add(
            ids=ids,
            embeddings=embeddings,
            documents=texts,
            metadatas=metadatas
        )

        indexed_count += len(batch)

    return indexed_count


def search_document_chunks(
    question: str,
    user_id: int,
    top_k: int = 3
) -> list[dict]:

    query_embedding = generate_embedding(question)

    results = knowledge_collection.query(
        query_embeddings=[query_embedding],
        n_results=top_k,
        where={"user_id": str(user_id)},
        include=[
            "documents",
            "metadatas",
            "distances"
        ]
    )

    matches = []

    if not results["ids"]:
        return matches

    for document_id, text, metadata, distance in zip(
        results["ids"][0],
        results["documents"][0],
        results["metadatas"][0],
        results["distances"][0]
    ):
        matches.append({
            "chunk_id": document_id,
            "document_id": metadata["document_id"],
            "filename": metadata["filename"],
            "chunk_index": metadata["chunk_index"],
            "page_number": (
                metadata["page_number"]
                if metadata["page_number"] != -1
                else None
            ),
            "content": text,
            "distance": round(distance, 4),
            "similarity_score": round(1 - distance, 4)
        })

    return matches

The batch approach avoids sending an entire large document to the embedding API in one request.
One architectural point: We are reusing the Day 18 ChromaDB collection, but using document_id and chunk_index metadata to distinguish document passages from the earlier knowledge records.
